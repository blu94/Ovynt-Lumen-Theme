{
  "extends": "products",
  "owns": [
    "is_exam",
    "access_days",
    "ideal_percent",
    "exam_duration_minutes",
    "papers"
  ],
  "handler": "Theme\\Backend\\Handlers\\ExamContributions",
  "tabs": [
    {
      "name": "Exam",
      "ui": {
        "type": "tab",
        "icon": "tabler-file-certificate"
      },
      "elements": [
        {
          "ui": {
            "type": "section",
            "cols": 12,
            "icon": "tabler-file-certificate"
          },
          "name": "Sell This Product As An Exam",
          "subtitle": "Switch this on and the product becomes an exam: buying it grants a candidate access, and you add its papers below. Everything commercial stays where it already is — the price, tax, discounts and catalogue listing on the tabs beside this one. Two things to check there: turn Requires Shipping OFF, since an exam has nothing to post and with it off checkout never asks for an address or charges a delivery fee; and set the product Active, or it will not appear in the catalogue however this tab is configured.",
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "is_exam",
              "type": "switch",
              "label": "This product is an exam",
              "hint": "Switching it off removes the exam from the catalogue and stops new enrolments. Nothing is deleted: the papers, the cases and every sitting anybody has taken are all kept, and switching it back on restores them",
              "default": false
            },
            {
              "ui": {
                "type": "field",
                "cols": 4
              },
              "key": "access_days",
              "type": "number",
              "label": "Access Window (days)",
              "placeholder": "e.g. 90",
              "hint": "How long access lasts from the moment a candidate starts. Copied onto each enrolment when it is created, so changing it here affects future sittings only and can never shorten a window somebody already holds",
              "default": 30,
              "rules": [
                "nullable",
                "integer",
                "min:1",
                "max:3650"
              ]
            },
            {
              "ui": {
                "type": "field",
                "cols": 4
              },
              "key": "ideal_percent",
              "type": "number",
              "label": "Target Score (%)",
              "placeholder": "e.g. 60",
              "hint": "The percentage of the maximum a candidate is aiming at, shown before they have a score of their own",
              "default": 60,
              "rules": [
                "nullable",
                "integer",
                "min:1",
                "max:100"
              ]
            },
            {
              "ui": {
                "type": "field",
                "cols": 4
              },
              "key": "exam_duration_minutes",
              "type": "number",
              "label": "Stated Duration (minutes)",
              "placeholder": "e.g. 180",
              "hint": "Display only, shown on the exam card. Each paper carries the timer that actually counts down",
              "rules": [
                "nullable",
                "integer",
                "min:1",
                "max:1440"
              ]
            }
          ]
        },
        {
          "ui": {
            "type": "section",
            "cols": 12,
            "icon": "tabler-list-numbers"
          },
          "name": "Papers",
          "subtitle": "A paper is a timed set of cases — the thing a candidate actually opens, times and finishes. An exam's papers each end independently, and the exam is complete once every one has been ended. Drag to reorder; that is the order candidates meet them in. Open a paper to add its cases — each case's images, brief and model answer live inside the paper's own dialog.",
          "elements": [
            {
              "ui": {
                "type": "field",
                "cols": 12
              },
              "key": "papers",
              "type": "repeater",
              "label": "Papers",
              "itemLabel": "Paper",
              "columns": [
                {
                  "label": "Paper",
                  "key": "title"
                },
                {
                  "label": "Minutes",
                  "key": "duration_minutes"
                },
                {
                  "label": "Cases",
                  "key": "cases",
                  "type": "count"
                },
                {
                  "label": "Status",
                  "key": "status",
                  "type": "status"
                }
              ],
              "dialog": {
                "width": 1100,
                "create": {
                  "title": "Add Paper",
                  "subtitle": "Its name, and the clock that runs while a candidate sits it."
                },
                "update": {
                  "title": "Edit Paper"
                }
              },
              "elements": [
                {
                  "ui": {
                    "type": "field",
                    "cols": 8
                  },
                  "key": "title",
                  "type": "text",
                  "label": "Paper Title",
                  "placeholder": "e.g. Paper 1 — Chest and Abdomen",
                  "translatable": true,
                  "rules": [
                    "required",
                    "max:180"
                  ]
                },
                {
                  "ui": {
                    "type": "field",
                    "cols": 4
                  },
                  "key": "status",
                  "type": "select",
                  "label": "Status",
                  "default": "active",
                  "hint": "Inactive removes it from new sittings. Anyone mid-paper is unaffected and every finished one still replays",
                  "options": {
                    "items": [
                      {
                        "title": "Active",
                        "value": "active"
                      },
                      {
                        "title": "Inactive",
                        "value": "inactive"
                      }
                    ]
                  },
                  "rules": [
                    "required"
                  ]
                },
                {
                  "ui": {
                    "type": "field",
                    "cols": 12
                  },
                  "key": "description",
                  "type": "textarea",
                  "label": "Description",
                  "placeholder": "What this paper covers, shown before the candidate starts it",
                  "translatable": true
                },
                {
                  "ui": {
                    "type": "field",
                    "cols": 4
                  },
                  "key": "duration_minutes",
                  "type": "number",
                  "label": "Duration (minutes)",
                  "placeholder": "e.g. 35",
                  "hint": "The timer that actually runs. Copied onto a sitting when the candidate opens the paper, so changing it later applies to new sittings only — anyone part-way through keeps the time they were given",
                  "default": 60,
                  "rules": [
                    "required",
                    "integer",
                    "min:1",
                    "max:1440"
                  ]
                },
                {
                  "ui": {
                    "type": "field",
                    "cols": 4
                  },
                  "key": "case_set_version",
                  "type": "number",
                  "label": "Case Set Version",
                  "hint": "Bump this by hand after materially changing the case list. It records which revision a sitting was served; it never changes what anybody is served, because a sitting always replays from its own frozen copy",
                  "default": 1,
                  "rules": [
                    "required",
                    "integer",
                    "min:1"
                  ]
                },
                {
                  "ui": {
                    "type": "field",
                    "cols": 12
                  },
                  "key": "cases",
                  "type": "repeater",
                  "label": "Cases",
                  "itemLabel": "Case",
                  "columns": [
                    {
                      "label": "Case",
                      "key": "title"
                    },
                    {
                      "label": "Images",
                      "key": "image_count",
                      "type": "count"
                    },
                    {
                      "label": "Max Score",
                      "key": "score_max"
                    },
                    {
                      "label": "Status",
                      "key": "status",
                      "type": "status"
                    }
                  ],
                  "dialog": {
                    "width": 1100,
                    "create": {
                      "title": "Add Case",
                      "subtitle": "The study to report, what the candidate is told, and the answer they will compare against once the paper ends."
                    },
                    "update": {
                      "title": "Edit Case"
                    }
                  },
                  "elements": [
                    {
                      "ui": {
                        "type": "field",
                        "cols": 12,
                        "displayMode": "single"
                      },
                      "key": "assets",
                      "type": "image",
                      "label": "Case Images",
                      "hint": "Upload in the order they should be read — a plain film and its lateral are a sequence, not a set. Stored privately: never served from a public folder, and every view is a short-lived signed link",
                      "rules": [
                        "nullable",
                        "array"
                      ],
                      "metadata": {
                        "*.id": [
                          "required",
                          "integer",
                          "exists:assets,id"
                        ]
                      },
                      "dropzoneOptions": {
                        "usage": "LUMEN_CASE_IMAGE",
                        "maxFiles": 12,
                        "acceptedFiles": "image/*",
                        "protectedDisk": true
                      }
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 8
                      },
                      "key": "title",
                      "type": "text",
                      "label": "Case Title",
                      "placeholder": "e.g. Chest radiograph — 54M, breathless",
                      "hint": "Staff-facing. Candidates see cases numbered in order, not by title",
                      "translatable": true,
                      "rules": [
                        "required",
                        "max:180"
                      ]
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 4
                      },
                      "key": "status",
                      "type": "select",
                      "label": "Status",
                      "default": "active",
                      "hint": "Inactive removes it from new sittings only",
                      "options": {
                        "items": [
                          {
                            "title": "Active",
                            "value": "active"
                          },
                          {
                            "title": "Inactive",
                            "value": "inactive"
                          }
                        ]
                      },
                      "rules": [
                        "required"
                      ]
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 12
                      },
                      "key": "brief",
                      "type": "textarea",
                      "label": "Clinical Brief",
                      "placeholder": "e.g. 54-year-old man, three days of breathlessness and pleuritic pain.",
                      "hint": "The context the candidate is given before looking at the images",
                      "translatable": true
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 8
                      },
                      "key": "instruction",
                      "type": "text",
                      "label": "Reporting Instruction",
                      "placeholder": "e.g. Report this study.",
                      "hint": "Shown directly above the report box",
                      "translatable": true,
                      "rules": [
                        "nullable",
                        "max:255"
                      ]
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 4
                      },
                      "key": "score_max",
                      "type": "number",
                      "label": "Maximum Score",
                      "placeholder": "e.g. 5",
                      "hint": "The ceiling a self-mark is validated against. Half marks allowed",
                      "default": 5,
                      "rules": [
                        "required",
                        "numeric",
                        "min:0.5",
                        "max:100"
                      ]
                    },
                    {
                      "ui": {
                        "type": "field",
                        "cols": 12
                      },
                      "key": "model_answer",
                      "type": "richtext",
                      "label": "Model Answer",
                      "hint": "Never sent to the candidate while the paper is open — not withheld by the page, but genuinely absent from what the sitting is served. Read only once they end the paper",
                      "translatable": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
