{
  "expandable": false,
  "headerActions": {
    "elements": [
      {
        "key": "reload",
        "ui": { "type": "button", "icon": "tabler-refresh", "color": "success", "rounded": true },
        "tooltip": "Refresh List",
        "action": "reload",
        "class": "ms-2"
      },
      {
        "key": "create",
        "ui": { "type": "button", "icon": "tabler-plus", "color": "primary", "rounded": "md" },
        "label": "New Case",
        "tooltip": "Click to add a new case",
        "action": "navigate",
        "to": "/module/exam-cases/create"
      }
    ]
  },
  "filters": {
    "elements": [
      {
        "ui": { "type": "field" },
        "key": "paper_id",
        "label": "Paper",
        "placeholder": "Any paper",
        "type": "select",
        "options": { "url": "/admin/modules/exam-cases/options", "master": "papers" }
      },
      {
        "ui": { "type": "field" },
        "key": "status",
        "label": "Status",
        "placeholder": "Select Status",
        "type": "select",
        "options": { "url": "/admin/modules/exam-cases/options", "master": "status" }
      }
    ]
  },
  "elements": [
    {
      "ui": { "type": "display" },
      "label": "ID",
      "key": "id",
      "sortable": true,
      "width": "60px"
    },
    {
      "ui": { "type": "display" },
      "label": "Case",
      "key": "title",
      "sortable": true,
      "searchable": true
    },
    {
      "ui": { "type": "display" },
      "label": "Paper",
      "key": "paper.title",
      "sortable": false
    },
    {
      "ui": { "type": "display" },
      "label": "Max Score",
      "key": "score_max",
      "sortable": true,
      "align": "center"
    },
    {
      "ui": { "type": "display" },
      "label": "Status",
      "key": "status",
      "sortable": false,
      "align": "center",
      "type": "status"
    }
  ],
  "actions": {
    "elements": [
      "edit",
      {
        "key": "delete",
        "action": "delete",
        "ui": { "type": "button", "icon": "tabler-trash", "color": "error", "rounded": true },
        "params": {
          "confirm": true,
          "confirmText": "Delete this case? Sittings that already served it keep replaying it exactly as it was."
        }
      }
    ],
    "class": "fit"
  }
}
