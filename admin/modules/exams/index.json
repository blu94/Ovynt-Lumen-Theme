{
  "expandable": false,
  "headerActions": {
    "elements": [
      {
        "key": "reload",
        "ui": { "type": "button", "icon": "tabler-refresh", "color": "success", "rounded": true },
        "tooltip": "Refresh List",
        "action": "reload",
        "class": "ms-2"
      },
      {
        "key": "create",
        "ui": { "type": "button", "icon": "tabler-plus", "color": "primary", "rounded": "md" },
        "label": "New Exam",
        "tooltip": "Click to add a new exam",
        "action": "navigate",
        "to": "/module/exams/create"
      }
    ]
  },
  "filters": {
    "elements": [
      {
        "ui": { "type": "field" },
        "key": "status",
        "label": "Status",
        "placeholder": "Select Status",
        "type": "select",
        "options": { "url": "/admin/modules/exams/options", "master": "status" }
      }
    ]
  },
  "elements": [
    {
      "ui": { "type": "display" },
      "label": "ID",
      "key": "id",
      "sortable": true,
      "width": "60px"
    },
    {
      "ui": { "type": "display" },
      "label": "Exam",
      "key": "title",
      "sortable": true,
      "searchable": true
    },
    {
      "ui": { "type": "display" },
      "label": "Slug",
      "key": "slug",
      "sortable": true,
      "searchable": true
    },
    {
      "ui": { "type": "display" },
      "label": "Papers",
      "key": "papers_count",
      "sortable": false,
      "align": "center"
    },
    {
      "ui": { "type": "display" },
      "label": "Access",
      "key": "access_days",
      "sortable": true,
      "align": "center"
    },
    {
      "ui": { "type": "display" },
      "label": "Status",
      "key": "status",
      "sortable": false,
      "align": "center",
      "type": "status"
    }
  ],
  "actions": {
    "elements": [
      "edit",
      {
        "key": "delete",
        "action": "delete",
        "ui": { "type": "button", "icon": "tabler-trash", "color": "error", "rounded": true },
        "params": {
          "confirm": true,
          "confirmText": "Delete this exam? Refused once anyone has sat it — set it to Inactive instead."
        }
      }
    ],
    "class": "fit"
  }
}
