{
  "elements": [
    {
      "ui": { "type": "section", "cols": 12, "icon": "tabler-user-check" },
      "name": "Who and What",
      "subtitle": "Granting access here bypasses the purchase gate on purpose — it is the support route for comping a candidate, for making good on a payment that failed to settle, and for extending somebody whose window lapsed mid-sitting. Buying an exam grants access on its own; you do not need this for an ordinary sale.",
      "elements": [
        {
          "ui": { "type": "field", "cols": 6, "autoSelectSingle": false },
          "key": "user_id",
          "type": "autocomplete",
          "label": "Candidate",
          "placeholder": "Search by name or email",
          "hint": "Cannot be changed afterwards. Moving an enrolment to a different person would silently reassign somebody else's answers",
          "options": { "url": "/admin/users/options" },
          "rules": ["required", "integer"]
        },
        {
          "ui": { "type": "field", "cols": 6, "autoSelectSingle": false },
          "key": "product_id",
          "type": "autocomplete",
          "label": "Exam",
          "placeholder": "Which exam?",
          "hint": "Cannot be changed afterwards, for the same reason",
          "options": { "url": "/admin/modules/enrolments/options", "master": "exams" },
          "rules": ["required", "integer"]
        },
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "reason",
          "type": "text",
          "label": "Reason",
          "placeholder": "e.g. Refunded card payment, access granted manually — ticket 4821",
          "hint": "Not stored on the enrolment; written to the activity log with the grant, which is where somebody will look in six months",
          "rules": ["nullable", "max:255"]
        }
      ]
    },
    {
      "ui": { "type": "section", "cols": 12, "icon": "tabler-calendar-clock" },
      "name": "The Window",
      "subtitle": "How long this access lasts, and what state it is in.",
      "elements": [
        {
          "ui": { "type": "field", "cols": 6 },
          "key": "expires_at",
          "type": "datetime",
          "label": "Expires",
          "hint": "Leave empty when granting and the exam's own access window is used, counted from today",
          "rules": ["nullable"]
        },
        {
          "ui": { "type": "field", "cols": 6 },
          "key": "mode",
          "type": "select",
          "label": "Mode",
          "default": "practice",
          "hint": "Practice is untimed. Moving a candidate to Timed clears their answers and restarts every clock, so it is normally their own choice rather than yours",
          "options": { "url": "/admin/modules/enrolments/options", "master": "mode" }
        }
      ]
    },
    {
      "ui": { "type": "section", "cols": 12, "icon": "tabler-report-analytics" },
      "name": "What They Actually Did",
      "subtitle": "One row per paper, straight from the server's own record. This is the evidence for a dispute about a timer or a lost answer — what was recorded, rather than what anybody remembers.",
      "elements": [
        { "ui": { "type": "field", "cols": 6 }, "key": "candidate_name", "type": "display", "label": "Candidate" },
        { "ui": { "type": "field", "cols": 6 }, "key": "candidate_email", "type": "display", "label": "Email" },
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "paper_progress",
          "type": "repeater",
          "label": "Papers",
          "itemLabel": "Paper",
          "columns": [
            { "label": "Paper", "key": "paper" },
            { "label": "Time Spent", "key": "spent" },
            { "label": "Time Left", "key": "left" },
            { "label": "Answered", "key": "answered" },
            { "label": "Marked", "key": "marked" },
            { "label": "Ended", "key": "ended" }
          ],
          "elements": [
            { "ui": { "type": "field", "cols": 12 }, "key": "paper", "type": "display", "label": "Paper" },
            { "ui": { "type": "field", "cols": 6 }, "key": "spent", "type": "display", "label": "Time Spent" },
            { "ui": { "type": "field", "cols": 6 }, "key": "left", "type": "display", "label": "Time Left" },
            { "ui": { "type": "field", "cols": 6 }, "key": "answered", "type": "display", "label": "Cases Answered" },
            { "ui": { "type": "field", "cols": 6 }, "key": "marked", "type": "display", "label": "Cases Marked" },
            { "ui": { "type": "field", "cols": 12 }, "key": "ended", "type": "display", "label": "Ended At" }
          ]
        }
      ]
    }
  ],
  "sidebar": {
    "elements": [
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "field" },
            "key": "status",
            "type": "select",
            "label": "Status",
            "default": "active",
            "hint": "Expired closes access and keeps every answer. There is no delete: removing an enrolment would take the candidate's history with it",
            "options": { "url": "/admin/modules/enrolments/options", "master": "status" },
            "rules": ["required"]
          },
          { "ui": { "type": "field" }, "key": "started_at", "type": "display", "label": "Started" },
          { "ui": { "type": "field" }, "key": "order_id", "type": "display", "label": "Granted By Order" }
        ]
      }
    ],
    "footer": {
      "elements": [
        {
          "ui": { "type": "row", "dense": true },
          "elements": [
            {
              "ui": { "type": "button", "color": "primary", "icon": "tabler-checkbox" },
              "action": "save",
              "label": "Save Changes",
              "redirect": false
            },
            {
              "ui": { "type": "button", "color": "secondary", "variant": "tonal", "icon": "tabler-arrow-left" },
              "action": "cancel",
              "label": "Cancel",
              "redirect": "/module/enrolments"
            }
          ]
        }
      ]
    }
  }
}
